# Port the API listens on inside the container
PORT=8787

# Postgres password (durable message history). DATABASE_URL is built from this in
# docker-compose.yml, no need to set it separately.
POSTGRES_PASSWORD=change-me-to-a-long-random-value

# Max /send calls per workspace per minute before requests get a 429
RATE_LIMIT_PER_MIN=60

# Tokens are no longer set here — each workspace gets its own token, issued with:
#   docker compose exec api bun scripts/issue-token.ts <workspace-name>
# (or `docker exec <container> bun scripts/issue-token.ts <workspace-name>` for a
# swarm-deployed stack). The token is stored in Valkey, not in this file.
